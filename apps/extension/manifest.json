{
  "manifest_version": 3,
  "name": "TripleKeel",
  "version": "0.1.0",
  "description": "A personal coach for knowledge work. Prompts are scored in your browser and never leave it.",
  "key": "",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
